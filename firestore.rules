rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Provision claims or allowlist documents from the Firebase Console/Admin SDK only.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function validPlayer() {
      return request.resource.data.keys().hasOnly(['name']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 &&
        request.resource.data.name.matches('.*\\S.*');
    }

    function validMatch() {
      let m = request.resource.data;
      return m.keys().hasAll(['homeTeam', 'awayTeam', 'scoreHome', 'scoreAway', 'status']) &&
        m.keys().hasOnly(['homeTeam', 'awayTeam', 'scoreHome', 'scoreAway', 'status', 'autoGenerated', 'matchDay', 'createdAt', 'completedAt']) &&
        m.homeTeam is string && m.homeTeam.size() > 0 && m.homeTeam.size() <= 80 &&
        m.awayTeam is string && m.awayTeam.size() > 0 && m.awayTeam.size() <= 80 &&
        m.homeTeam != m.awayTeam && m.status in ['Upcoming', 'Live', 'Finished'] &&
        ((m.status == 'Upcoming' && m.scoreHome == null && m.scoreAway == null) ||
         (m.scoreHome is int && m.scoreHome >= 0 && m.scoreAway is int && m.scoreAway >= 0));
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlayer();
      allow delete: if isAdmin();
    }
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMatch();
      allow delete: if isAdmin();
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
